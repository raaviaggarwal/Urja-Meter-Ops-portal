{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy Meter API",
    "description": "Read‐only API over the Flock Energy meter operations dataset.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/meters": {
      "get": {
        "summary": "List Meters",
        "description": "List meters with pagination, search, and hierarchical filters.\n\nThe returned dict contains:\n- ``meters``: list of summary records\n- ``total``: total number of matching records (before pagination)\n- ``page``, ``per_page``, ``total_pages``: pagination metadata",
        "operationId": "list_meters_api_meters_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1‐indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1‐indexed)"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Per Page"
            },
            "description": "Items per page"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring search on meterId or serialNo",
              "title": "Search"
            },
            "description": "Substring search on meterId or serialNo"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(Installed|Faulty|Decommissioned)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status",
              "title": "Status"
            },
            "description": "Filter by installation status"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(single|three)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by electrical phase type",
              "title": "Phase Type"
            },
            "description": "Filter by electrical phase type"
          },
          {
            "name": "build",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(legacy|v2)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by build version",
              "title": "Build"
            },
            "description": "Filter by build version"
          },
          {
            "name": "zone_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone code (Z-01, Z-02, Z-03)",
              "title": "Zone Code"
            },
            "description": "Filter by zone code (Z-01, Z-02, Z-03)"
          },
          {
            "name": "division_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by division code (D-01 … D-10)",
              "title": "Division Code"
            },
            "description": "Filter by division code (D-01 … D-10)"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by DT code (DT-001 … DT-040)",
              "title": "Dt Code"
            },
            "description": "Filter by DT code (DT-001 … DT-040)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedMeterSummaries"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/search": {
      "get": {
        "summary": "Search Meters",
        "description": "Search meters by meterId or serial number substring.\n\nReturns matching records as summary objects.",
        "operationId": "search_meters_api_meters_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Substring to search on meterId or serialNo",
              "title": "Query"
            },
            "description": "Substring to search on meterId or serialNo"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterSearchResults"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/status/{status}": {
      "get": {
        "summary": "List Meters By Status",
        "description": "List meters filtered by installation status.\n\nReturns a summary list and the total count for the given status.",
        "operationId": "list_meters_by_status_api_meters_status__status__get",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(Installed|Faulty|Decommissioned)$",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetersByStatus"
