    "/api/meters/{meter_id}": {
      "get": {
        "summary": "Get Meter",
        "description": "Retrieve a single meter's full metadata record.\n\nReturns a 404 response if the meterId does not exist in the dataset.",
        "operationId": "get_meter_api_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
