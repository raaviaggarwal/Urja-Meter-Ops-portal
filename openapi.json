{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy Meter API",
    "description": "Read‑only API over the Flock Energy meter operations dataset.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/meters": {
      "get": {
        "summary": "List Meters",
        "description": "List meters with pagination, search, and hierarchical filters.\n\nThe returned dict contains:\n- ``meters``: list of summary records\n- ``total``: total number of matching records (before pagination)\n- ``page``, ``per_page``, ``total_pages``: pagination metadata",
        "operationId": "list_meters_api_meters_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1‑indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1‑indexed)"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Per Page"
            },
            "description": "Items per page"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring search on meterId or serialNo",
              "title": "Search"
            },
            "description": "Substring search on meterId or serialNo"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(Installed|Faulty|Decommissioned)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status",
              "title": "Status"
            },
            "description": "Filter by installation status"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(single|three)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by electrical phase type",
              "title": "Phase Type"
            },
            "description": "Filter by electrical phase type"
          },
          {
            "name": "build",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(legacy|v2)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by build version",
              "title": "Build"
            },
            "description": "Filter by build version"
          },
          {
            "name": "zone_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone code (Z-01, Z-02, Z-03)",
              "title": "Zone Code"
            },
            "description": "Filter by zone code (Z-01, Z-02, Z-03)"
          },
          {
            "name": "division_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by division code (D-01 … D-10)",
              "title": "Division Code"
            },
            "description": "Filter by division code (D-01 … D-10)"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by DT code (DT-001 … DT-040)",
              "title": "Dt Code"
            },
            "description": "Filter by DT code (DT-001 … DT-040)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Meters Api Meters Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/search": {
      "get": {
        "summary": "Search Meters",
        "description": "Search meters by meterId or serial number substring.\n\nReturns matching records as summary objects.",
        "operationId": "search_meters_api_meters_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Substring to search on meterId or serialNo",
              "title": "Query"
            },
            "description": "Substring to search on meterId or serialNo"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Search Meters Api Meters Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/status/{status}": {
      "get": {
        "summary": "List Meters By Status",
        "description": "List meters filtered by installation status.\n\nReturns a summary list and the total count for the given status.",
        "operationId": "list_meters_by_status_api_meters_status__status__get",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(Installed|Faulty|Decommissioned)$",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Meters By Status Api Meters Status  Status  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "summary": "List Transformers",
        "description": "Provide transformer‑derived information from the meter dataset.\n\nThis endpoint does not fabricate capacities or electrical ratings; it\nexposes the hierarchy information that is available from the meter\nrecords. Each unique DT (distribution transformer) appearing in the\ndataset is listed with its associated zone, circle, subdivision,\nsubstation, and feeder codes/names as observed in the data.\n\nThe response format is intentionally lightweight — it reflects what\ncan be derived from the 403‑record export without making assumptions\nabout fields that are not present.",
        "operationId": "list_transformers_api_transformers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List Transformers Api Transformers Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/export/meters": {
      "get": {
        "summary": "Export Meters",
        "description": "Return the verified meter dataset.\n\nThis endpoint returns the 403‑record export that lives alongside the\nAPI code. It documents the known discrepancy with the portal UI (405\nmeters displayed vs. 403 records exported) without inventing the\nmissing records or their reason.",
        "operationId": "export_meters_api_export_meters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Export Meters Api Export Meters Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/metadata": {
      "get": {
        "summary": "Get Metadata",
        "description": "Get data source metadata and freshness information.\n\nReturns metadata about the meter dataset including:\n- Record count\n- Source filename\n- File modification time (local file system metadata)\n- Freshness policy\n\nThis endpoint does not connect to the live portal and does not\nprovide real-time data. All data comes from the static export\nfile meter-export.json alongside the API code.",
        "operationId": "get_metadata_api_metadata_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Metadata Api Metadata Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/nearby": {
      "get": {
        "summary": "Nearby Meters",
        "description": "Find meters near a given location using the Haversine formula.\n\nParameters:\n- latitude: Latitude in decimal degrees (-90 to 90)\n- longitude: Longitude in decimal degrees (-180 to 180)\n- radius_km: Search radius in kilometres (maximum 500)\n\nReturns meters sorted by ascending distance with their distance in km.\nResults with missing or nil coordinates are silently skipped.",
        "operationId": "nearby_meters_api_meters_nearby_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Latitude in decimal degrees, -90 to 90",
              "title": "Latitude"
            },
            "description": "Latitude in decimal degrees, -90 to 90"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Longitude in decimal degrees, -180 to 180",
              "title": "Longitude"
            },
            "description": "Longitude in decimal degrees, -180 to 180"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 500,
              "exclusiveMinimum": 0,
              "description": "Search radius in kilometres",
              "title": "Radius Km"
            },
            "description": "Search radius in kilometres"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Nearby Meters Api Meters Nearby Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/hierarchy": {
      "get": {
        "summary": "Get Hierarchy",
        "description": "Reconstructed meter network hierarchy from the exported dataset.\n\nReturns a nested tree showing zones → circles → divisions → subdivisions\n→ substations → feeders → distribution transformers (DTs), with meter\ncounts at each level and sample meterIds.\n\nQuery parameters:\n- zone_code: optional filter to a specific zone code\n\nResponse format:\n- zones: dict of zone_name → {code, circles: dict}\n- total_records: total meters in the dataset (403)",
        "operationId": "get_hierarchy_api_hierarchy_get",
        "parameters": [
          {
            "name": "zone_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone code (e.g., Z-01, Z-02, Z-03)",
              "title": "Zone Code"
            },
            "description": "Filter by zone code (e.g., Z-01, Z-02, Z-03)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Hierarchy Api Hierarchy Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/query": {
      "get": {
        "summary": "Query Meters",
        "description": "List meters with combined attribute filtering (AND semantics).\n\nSupports filtering by any combination of:\n- ``status`` — installation status\n- ``make`` — meter manufacturer\n- ``phase_type`` — single or three\n- ``install_type`` — CT Operated or Whole Current\n- ``dt_code`` — distribution transformer code\n- ``zone_code`` — zone code from hierarchy\n- ``circle_code`` — circle code from hierarchy\n- ``feeder_code`` — feeder code from hierarchy\n\nFilters are applied together using AND semantics.  Unknown or\nunmatching filter values simply reduce the result set.\n\nPagination follows the same scheme as ``/api/meters``:\n``page`` and ``per_page`` with ``total_pages`` metadata.\n\nEmpty results return ``{ \"meters\": [], \"total\": 0, \"page\": 1, \"total_pages\": 0 }``.",
        "operationId": "query_meters_api_meters_query_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(Installed|Faulty|Decommissioned)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status",
              "title": "Status"
            },
            "description": "Filter by installation status"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter make",
              "title": "Make"
            },
            "description": "Filter by meter make"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(single|three)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by electrical phase type",
              "title": "Phase Type"
            },
            "description": "Filter by electrical phase type"
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation type",
              "title": "Install Type"
            },
            "description": "Filter by installation type"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by DT code (DT-001 through DT-040)",
              "title": "Dt Code"
            },
            "description": "Filter by DT code (DT-001 through DT-040)"
          },
          {
            "name": "zone_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone code (Z-01, Z-02, Z-03)",
              "title": "Zone Code"
            },
            "description": "Filter by zone code (Z-01, Z-02, Z-03)"
          },
          {
            "name": "circle_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by circle code (e.g., C-01, or empty)",
              "title": "Circle Code"
            },
            "description": "Filter by circle code (e.g., C-01, or empty)"
          },
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by feeder code (e.g., F-001, or empty)",
              "title": "Feeder Code"
            },
            "description": "Filter by feeder code (e.g., F-001, or empty)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1‑indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1‑indexed)"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Per Page"
            },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Query Meters Api Meters Query Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
